{"draw": <%= params[:draw] || -1 %>,
 "recordsTotal": <%= @total_objects %>,
 "recordsFiltered": <%= @total_objects %>,
 "data":[
<% @objects.each do |user| %>
  [
   "<%= user.id%><div id='user-id' class='hidden-item'><%= user.id%></div>",
   "<%= editablefieldcreate('name', user,"user@email.com",{:divclass=>"table-item"}).gsub("\"", "'").html_safe() %>",
   "<%= editablefieldcreate('first_name',  user.user_attribute,"First",{:divclass=>"table-item"}).gsub("\"", "'").html_safe() %>",
   "<%= editablefieldcreate('last_name', user.user_attribute,"Last",{:divclass=>"table-item"}  ).gsub("\"", "'").html_safe() %>",
   <% current_label = user.multi_factor_type.present? ? user.multi_factor_type : 'Default' %>
   <% current_value = user.multi_factor_type.present? ? user.multi_factor_type : '' %>
   <% options = [[current_label, current_value], ['Default',''], ['None','None'], ['Text','Text'], ['Email','Email']] %>
   <% options << ['Authpoint','Authpoint'] if authpoint_configured? %>
   <% ap_label = user.try(:authpoint_auth_method).present? ? user.authpoint_auth_method : 'No Preference' %>
   <% ap_value = user.try(:authpoint_auth_method).present? ? user.authpoint_auth_method : '' %>
   <% ap_opts = [[ap_label, ap_value], ['No Preference',''], ['Push','Push'], ['OTP','OTP'], ['QRCode','QRCode']] %>
   "<%= ajax_select('multi_factor_type','user',user, options.uniq).gsub("\"", "'").gsub("\n", " ").html_safe() %><span class='authpoint-method-cell' style='<%= user.effective_multi_factor_type == 'Authpoint' ? '' : 'display:none;' %>'><br><%= ajax_select('authpoint_auth_method','user',user, ap_opts.uniq).gsub("\"", "'").gsub("\n", " ").html_safe() %></span>",
   "<%= user.roles.collect {|p| [ p.name] }.join(', ') %>",
   "<center><%=("<div class='delete-user-item'>" + image_tag('interface/delete.png', :border=>'0').gsub("\"", "'").html_safe() + "</div>").gsub("\"", "'").html_safe() + "     "+
     link_to(image_tag('interface/edit.png', :border=>'0', :width=>"20"),"#",{:onclick=>"return(false)", :class=>'edit-user-item', :title=>"Edit User"}).gsub("\"", "'").html_safe() + "     "+
     link_to(image_tag('interface/lock16.png', :border=>'0'),"#",{:onclick=>"return(false)",:class=>'password-user-item', :title=>"Change Password"}).gsub("\"", "'").html_safe() %> </center>"
  ] <% if @objects.last != user then %> , <% end %>
<% end %>
]}
